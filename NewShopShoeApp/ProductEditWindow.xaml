<Window x:Class="NewShopShoeApp.ProductEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NewShopShoeApp"
        mc:Ignorable="d"
        Title="ProductEditWindow" 
        Height="700" 
        Width="600"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource WindowStyle}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="ID: "
                   Name="IdTextBlock"
                   Margin="5"
                   VerticalAlignment="Center"/>
        <TextBox x:Name="IdTextBox"
                 Margin="5"
                 IsReadOnly="True"
                 Grid.Column="1"/>
        <TextBlock Text="Артикул: "
                   Margin="5"
                   VerticalAlignment="Center"
                   Grid.Row="1"
                   Grid.Column="0"/>
        <TextBox x:Name="ArticleTextBox"
                 Margin="5"
                 Grid.Row="1"
                 Grid.Column="1"/>
        <TextBlock Text="Наименование: "
                   Margin="5"
                   VerticalAlignment="Center"
                   Grid.Row="2"
                   Grid.Column="0"/>
        <TextBox x:Name="NameTextBox"
                 Margin="5"
                 Grid.Row="2"
                 Grid.Column="1"/>
        <TextBlock Text="Категория: "
                   Margin="5"
                   VerticalAlignment="Center"
                   Grid.Row="3"
                   Grid.Column="0"/>
        <ComboBox x:Name="CategoryComboBox"
                  Margin="5"
                  Grid.Row="3"
                  Grid.Column="1"
                  DisplayMemberPath="Name"
                  SelectedValuePath="Id"/>
        <TextBlock Text="Описание: "
                   Margin="5"
                   VerticalAlignment="Center"
                   Grid.Row="4"
                   Grid.Column="0"/>
        <TextBox x:Name="DescriptionTextBox"
                 Margin="5"
                 Grid.Row="4"
                 Grid.Column="1"/>
        <TextBlock Text="Производитель: "
                   Margin="5"
                   VerticalAlignment="Center"
                   Grid.Row="5"
                   Grid.Column="0"/>
        <ComboBox x:Name="ProducerComboBox"
                  Margin="5"
                  Grid.Row="5"
                  Grid.Column="1"
                  DisplayMemberPath="Name"
                  SelectedValuePath="Id"/>
        <TextBlock Text="Поставщик: "
                   Margin="5"
                   VerticalAlignment="Center"
                   Grid.Row="6"
                   Grid.Column="0"/>
        <ComboBox x:Name="SupplierComboBox"
                  Margin="5"
                  Grid.Row="6"
                  Grid.Column="1"
                  DisplayMemberPath="Name"
                  SelectedValuePath="Id"/>
        <TextBlock Text="Цена: "
                   Margin="5"
                   VerticalAlignment="Center"
                   Grid.Row="7"
                   Grid.Column="0"/>
        <TextBox x:Name="PriceTextBox"
                 Margin="5"
                 Grid.Row="7"
                 Grid.Column="1"/>
        <TextBlock Text="Единица измерения: "
                   Margin="5"
                   VerticalAlignment="Center"
                   Grid.Row="8"
                   Grid.Column="0"/>
        <ComboBox x:Name="UnitComboBox"
                  Margin="5"
                  Grid.Row="8"
                  Grid.Column="1"
                  DisplayMemberPath="Name"
                  SelectedValuePath="Id"/>
        <TextBlock Text="Количество: "
                   Margin="5"
                   VerticalAlignment="Center"
                   Grid.Row="9"
                   Grid.Column="0"/>
        <TextBox x:Name="AmountStockTextBox"
                 Margin="5"
                 Grid.Row="9"
                 Grid.Column="1"/>
        <TextBlock Text="Скидка: "
                   Margin="5"
                   VerticalAlignment="Center"
                   Grid.Row="10"
                   Grid.Column="0"/>
        <TextBox x:Name="DiscountTextBox"
                 Margin="5"
                 Grid.Row="10"
                 Grid.Column="1"/>
        <TextBlock Text="Фото: "
                   Margin="5"
                   VerticalAlignment="Center"
                   Grid.Row="11"
                   Grid.Column="0"/>
        <StackPanel Grid.Row="11"
                    Grid.Column="1"
                    Margin="5"
                    Orientation="Horizontal">
            <Button x:Name="SelectPhotoButton" 
                    Content="Выбрать фото" 
                    Width="100" 
                    Click="SelectPhotoButton_Click"/>
            <Image x:Name="PhotoPreview" 
                   Width="50" 
                   Height="50" 
                   Margin="10 0" 
                   Stretch="Uniform"/>
        </StackPanel>
        <StackPanel Grid.Row="12"
                    Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="10">
            <Button x:Name="SaveButton" 
                    Content="Сохранить" 
                    Width="100" 
                    Height="50" 
                    Margin="5" 
                    Click="SaveButton_Click"/>
            <Button x:Name="CancelButton" 
                    Content="Отмена" 
                    Width="100" 
                    Height="50" 
                    Margin="5" 
                    Click="CancelButton_Click"/>

        </StackPanel>
    </Grid>
</Window>
