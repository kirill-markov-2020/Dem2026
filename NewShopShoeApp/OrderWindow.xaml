<Window x:Class="NewShopShoeApp.OrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NewShopShoeApp"
        mc:Ignorable="d"
        Title="Заказы" 
        Height="600" 
        Width="800"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource WindowStyle}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="75*"/>
            <RowDefinition Height="350*"/>
            <RowDefinition Height="75*"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock x:Name="FIOTextBlock"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Top"
                       Margin="10 10 10 0"/>
            <TextBlock Text="Заказы"
                       HorizontalAlignment="Center"/>
        </StackPanel>
        <ListBox x:Name="OrderList"
                 Grid.Row="1"
                 HorizontalContentAlignment="Stretch"
                 MouseDoubleClick="OrderList_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border CornerRadius="10"
                            Background="#7FFF00">
                        <Border.ContextMenu>
                            <ContextMenu>
                                <MenuItem Name="EditOrder" 
                                          Header="Редактировать"
                                          Tag="{Binding}"
                                          Click="EditOrder_Click"/>
                                <MenuItem Name="DeleteOrder" 
                                          Header="Удалить"
                                          Tag="{Binding}"
                                          Click="DeleteOrder_Click"/>
                            </ContextMenu>
                        </Border.ContextMenu>
                        <Grid>
                            <Grid.ColumnDefinitions>
                              
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <Border Grid.Column="0" 
                                    Margin="5 0"
                                    BorderThickness="1">
                                <StackPanel >
                                    <TextBlock FontWeight="Bold">
                                        <Run Text="Артикул заказа: "/>
                                        <Run Text="{Binding Article}"/>
                                    </TextBlock>
                                    <TextBlock>
                                        <Run Text="Статус заказа: "/>
                                        <Run Text="{Binding Status.Name}"/>
                                    </TextBlock>
                                    <TextBlock>
                                        <Run Text="Пункт выдачи: "/>
                                        <Run Text="{Binding PickUpPoint.FullAddress, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock>
                                        <Run Text="Дата заказа: "/>
                                        <Run Text="{Binding OrderDate, StringFormat=dd.MM.yyy}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1"
                                    Margin="5 0">
                                <TextBlock VerticalAlignment="Center">
                                    <Run Text="🚚"/>
                                    <Run Text="{Binding DeliveryDate, StringFormat=dd.MM.yyyy}"/>
                                </TextBlock>
                            </Border>


                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Button x:Name="BackButton" 
                Content="Выйти"
                Click="BackButton_Click"
                HorizontalAlignment="Left"
                Grid.Row="2"
                Margin="10 10"
                Width="150"
                Height="50"/>
        <Button x:Name="AddOrderButton" 
                Content="Добавить заказ"
                Click="AddOrderButton_Click"
                HorizontalAlignment="Right"
                Grid.Row="2"
                Margin="10 10"
                Width="150"
                Height="50"/>
    </Grid>
</Window>
