<Window x:Class="NewShopShoeApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NewShopShoeApp"
        mc:Ignorable="d"
        Title="Авторизация" 
        Height="450" 
        Width="600"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource WindowStyle}">
    <Border HorizontalAlignment="Center" 
            VerticalAlignment="Center" 
            CornerRadius="10">
        <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Margin="20 10"
                    Width="200">
            <TextBlock Text="Авторизация"
                       HorizontalAlignment="Center"
                       Margin="10 5"/>
            <TextBox x:Name="LoginTextBox"
                     Margin="0 5"
                     Text="94d5ous@gmail.com"
                     TextWrapping="Wrap"/>
            <PasswordBox x:Name="PasswordBox"
                         Password="uzWC67"
                         Margin="0 5"/>
            <Button x:Name="AuthorizationButton"
                    Content="Войти"
                    Margin="0 10"
                    Click="AuthorizationButton_Click"/>
            <TextBlock x:Name="GuestAuthorizationTextBlock"
                       Text="Войти как гость"
                       Margin="20 5"
                       Foreground="Blue"
                       FontSize="12"
                       HorizontalAlignment="Center"
                       MouseDown="GuestAuthorizationTextBlock_MouseDown"/>

        </StackPanel>
    </Border>
</Window>
