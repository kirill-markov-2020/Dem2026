<Window x:Class="NewShopShoeApp.ProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NewShopShoeApp"
        xmlns:con="clr-namespace:NewShopShoeApp.Converters"
        mc:Ignorable="d"
        Title="Товары" 
        Height="800" 
        Width="1200"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource WindowStyle}">
    <Window.Resources>
        <con:ImagePathConverter x:Key="ImageConverter"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="125*"/>
            <RowDefinition Height="350*"/>
            <RowDefinition Height="75*"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock x:Name="FIOTextBlock"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Top"
                       Margin="10 10 10 0"/>
            <TextBlock Text="Товары"
                       HorizontalAlignment="Center"/>
            <StackPanel Orientation="Horizontal"
                        x:Name="FilterPanel">
                <ComboBox x:Name="SortingCombobox"
                          SelectedIndex="0"
                          Margin="20 0"
                          Width="200"
                          Height="50"
                          SelectionChanged="SortingCombobox_SelectionChanged">
                    <ComboBoxItem Content="По умолчанию"/>
                    <ComboBoxItem Content="По убыванию"/>
                    <ComboBoxItem Content="По возрастанию"/>
                </ComboBox>
                <ComboBox x:Name="FilteringCombobox"
                          SelectedIndex="0"
                          Margin="20 0"
                          Width="200"
                          Height="50"
                          SelectionChanged="FilteringCombobox_SelectionChanged"/>
                <TextBox x:Name="SearchTextBox"
                         TextChanged="SearchTextBox_TextChanged"
                         Margin="20 5"
                         Width="200"
                         Height="50"/>

            </StackPanel>
        </StackPanel>
        <ListBox x:Name="ProductList"
                 Grid.Row="1"
                 HorizontalContentAlignment="Stretch"
                 MouseDoubleClick="ProductList_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border CornerRadius="10"
                            Background="{Binding BackgroundColor}">
                        <Border.ContextMenu>
                            <ContextMenu>
                                <MenuItem Name="EditProduct" 
                                          Header="Редактировать"
                                          Tag="{Binding}"
                                          Click="EditProduct_Click"/>
                                <MenuItem Name="DeleteProduct" 
                                          Header="Удалить"
                                          Tag="{Binding}"
                                          Click="DeleteProduct_Click"/>
                            </ContextMenu>
                        </Border.ContextMenu>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Margin="5 0">
                                <Image Source="{Binding Photo, Converter={StaticResource ImageConverter}}"
                                       Height="110"
                                       Width="110"/>
                            </Border>
                            <Border Grid.Column="1" 
                                    Margin="5 0"
                                    BorderThickness="1">
                                <StackPanel >
                                    <TextBlock FontWeight="Bold">
                                        <Run Text="{Binding Category.Name}"/>
                                        <Run Text=" | "/>
                                        <Run Text="{Binding Name}"/>
                                    </TextBlock>
                                    <TextBlock>
                                        <Run Text="Описание товара: "/>
                                        <Run Text="{Binding Description}"/>
                                    </TextBlock>
                                    <TextBlock>
                                        <Run Text="Производитель: "/>
                                        <Run Text="{Binding Producer.Name}"/>
                                    </TextBlock>
                                    <TextBlock>
                                        <Run Text="Поставщик: "/>
                                        <Run Text="{Binding Supplier.Name}"/>
                                    </TextBlock>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Цена: "/>
                                        <TextBlock Text="{Binding NewPrice, Mode=OneWay, StringFormat={}{0:F2} руб. }"/>
                                        <TextBlock Text=" "/>
                                        <TextBlock x:Name="OldPriceRunText" Text="{Binding Price, StringFormat={}{0:F2} руб.}"
                                             TextDecorations="Strikethrough" 
                                             Foreground="Red"
                                             Visibility="{Binding PriceVisibility}"/>
                                    </StackPanel>
                                    <TextBlock>
                                        <Run Text="Единица измерения: "/>
                                        <Run Text="{Binding Unit.Name}"/>
                                    </TextBlock>
                                    <TextBlock>
                                        <Run Text="Количество на складе: "/>
                                        <Run Text="{Binding AmountStock}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2"
                                    Margin="5 0">
                                <TextBlock VerticalAlignment="Center">
                                    <Run Text="Действующая скидка: "/>
                                    <Run Text="{Binding Discount, StringFormat={}{0:0}%}"/>
                                </TextBlock>
                            </Border>
                            
                            
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Button x:Name="BackButton" 
                Content="Выйти"
                Click="BackButton_Click"
                HorizontalAlignment="Left"
                Grid.Row="2"
                Margin="10 10"
                Width="150"
                Height="50"/>
        <Button x:Name="AddProductButton" 
                Content="Добавить товар"
                Click="AddProductButton_Click"
                HorizontalAlignment="Center"
                Grid.Row="2"
                Margin="10 10"
                Width="150"
                Height="50"/>
        <Button x:Name="OrderButton" 
                Content="Заказы"
                Click="OrderButton_Click"
                HorizontalAlignment="Right"
                Grid.Row="2"
                Margin="10 10"
                Width="150"
                Height="50"/>
    </Grid>
</Window>
