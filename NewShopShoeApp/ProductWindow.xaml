<Window x:Class="NewShopShoeApp.ProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NewShopShoeApp"
        xmlns:converters="clr-namespace:NewShopShoeApp.Converters"
        mc:Ignorable="d"
        Title="Товары" 
        Height="600" 
        Width="800"
        Style="{StaticResource WindowStyle}">
    <Window.Resources>
        <converters:ImagePathConverter x:Key="ImagePathConverter"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="75*"/>
            <RowDefinition Height="450*"/>
            <RowDefinition Height="75*"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock x:Name="FIOTextBlock"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Top"
                       Margin="10 10 10 0"/>
            <TextBlock Text="Товары"
                       HorizontalAlignment="Center"/>
            
        </StackPanel>
        <ListBox x:Name="ProductList"
                 Grid.Row="1"
                 HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border CornerRadius="10"
                            Background="{Binding BackgroundColor}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Margin="5 0">
                                <Image Source="{Binding Photo, Converter={StaticResource ImagePathConverter}}"
                                       Height="110"
                                       Width="110"/>
                            </Border>
                            <Border Grid.Column="1" 
                                    Margin="5 0"
                                    BorderThickness="1">
                                <StackPanel >
                                    <TextBlock FontWeight="Bold">
                                        <Run Text="{Binding Category.Name}"/>
                                        <Run Text=" | "/>
                                        <Run Text="{Binding Name}"/>
                                    </TextBlock>
                                    <TextBlock>
                                        <Run Text="Описание товара: "/>
                                        <Run Text="{Binding Description}"/>
                                    </TextBlock>
                                    <TextBlock>
                                        <Run Text="Производитель: "/>
                                        <Run Text="{Binding Producer.Name}"/>
                                    </TextBlock>
                                    <TextBlock>
                                        <Run Text="Поставщик: "/>
                                        <Run Text="{Binding Supplier.Name}"/>
                                    </TextBlock>
                                    <TextBlock>
                                        <Run Text="Цена: "/>
                                        <Run Text="{Binding NewPrice, Mode=OneWay, StringFormat={}{0:F2} руб.}"/>
                                        <Run Text="{Binding Price, StringFormat={}{0:F2} руб.}"
                                             TextDecorations="Strikethrough"
                                             Foreground="Red"/>
                                    </TextBlock>
                                    <TextBlock>
                                        <Run Text="Единица измерения: "/>
                                        <Run Text="{Binding Unit.Name}"/>
                                    </TextBlock>
                                    <TextBlock>
                                        <Run Text="Количество на складе: "/>
                                        <Run Text="{Binding AmountStock}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2"
                                    Margin="5 0">
                                <TextBlock VerticalAlignment="Center">
                                    <Run Text="Действующая скидка: "/>
                                    <Run Text="{Binding Discount, StringFormat={}{0:0}%}"/>
                                </TextBlock>
                            </Border>
                            
                            
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Button x:Name="BackButton" 
                Content="Выйти"
                Click="BackButton_Click"
                HorizontalAlignment="Left"
                Grid.Row="2"
                Margin="10 10"
                Width="150"
                Height="50"/>
    </Grid>
</Window>
